datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
  SYSTEM
}

enum OrderType {
  B2B
  B2C
}

enum RateType {
  INTRA_ZONE
  INTER_ZONE
}

enum SurchargeType {
  FLAT
  PERCENTAGE
}

enum PaymentType {
  PREPAID
  COD
}

enum OrderStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
  CANCELLED
}

enum AgentStatus {
  AVAILABLE
  ON_DELIVERY
  OFFLINE
}

enum AssignmentType {
  MANUAL
  AUTO
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                   String                 @id @default(uuid()) @db.Uuid
  role                 Role
  name                 String
  email                String                 @unique
  phone                String                 @unique
  passwordHash         String                 @map("password_hash")
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz
  refreshTokens        RefreshToken[]
  rateCards            RateCard[]             @relation("RateCardCreator")
  agent                Agent?
  ordersCustomer       Order[]                @relation("OrderCustomer")
  ordersCreator        Order[]                @relation("OrderCreator")
  trackingEvents       OrderTrackingEvent[]   @relation("TrackingEventActor")
  rescheduleRequests   RescheduleRequest[]    @relation("RescheduleRequester")

  @@map("users")
}

model RefreshToken {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  user            User           @relation(fields: [userId], references: [id])
  tokenHash       String         @map("token_hash")
  revoked         Boolean        @default(false)
  replacedBy      String?        @map("replaced_by") @db.Uuid
  replacedByToken RefreshToken?  @relation("ReplacementToken", fields: [replacedBy], references: [id])
  replacements    RefreshToken[] @relation("ReplacementToken")
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@map("refresh_tokens")
}

model Zone {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  code          String         @unique
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  pincodes      ZonePincode[]
  agents        Agent[]
  ordersPickup  Order[]        @relation("PickupZone")
  ordersDrop    Order[]        @relation("DropZone")

  @@map("zones")
}

model ZonePincode {
  id       String @id @default(uuid()) @db.Uuid
  zoneId   String @map("zone_id") @db.Uuid
  zone     Zone   @relation(fields: [zoneId], references: [id])
  pincode  String @unique

  @@map("zone_pincodes")
}

model RateCard {
  id                   String     @id @default(uuid()) @db.Uuid
  orderType            OrderType  @map("order_type")
  rateType             RateType   @map("rate_type")
  basePrice            Decimal    @map("base_price") @db.Decimal(10, 2)
  baseWeightKg         Decimal    @map("base_weight_kg") @db.Decimal(6, 2)
  additionalPricePerKg Decimal    @map("additional_price_per_kg") @db.Decimal(10, 2)
  effectiveFrom        DateTime   @map("effective_from") @db.Timestamptz
  effectiveTo          DateTime?  @map("effective_to") @db.Timestamptz
  createdBy            String     @map("created_by") @db.Uuid
  creator              User       @relation("RateCardCreator", fields: [createdBy], references: [id])
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz
  orders               Order[]

  @@map("rate_cards")
  @@unique([orderType, rateType, effectiveFrom])
}

model CodSurchargeConfig {
  id             String        @id @default(uuid()) @db.Uuid
  orderType      OrderType     @map("order_type")
  surchargeType  SurchargeType @map("surcharge_type")
  value          Decimal       @db.Decimal(10, 2)
  effectiveFrom  DateTime      @map("effective_from") @db.Timestamptz
  effectiveTo    DateTime?     @map("effective_to") @db.Timestamptz

  @@map("cod_surcharge_config")
}

model Agent {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @unique @map("user_id") @db.Uuid
  user                 User          @relation(fields: [userId], references: [id])
  zoneId               String        @map("zone_id") @db.Uuid
  zone                 Zone          @relation(fields: [zoneId], references: [id])
  currentLat           Decimal?      @map("current_lat") @db.Decimal(9, 6)
  currentLng           Decimal?      @map("current_lng") @db.Decimal(9, 6)
  status               AgentStatus   @default(OFFLINE)
  lastLocationUpdate   DateTime?     @map("last_location_update") @db.Timestamptz
  lastActiveAt         DateTime?     @map("last_active_at") @db.Timestamptz
  maxConcurrentOrders  Int           @default(1) @map("max_concurrent_orders")
  orders               Order[]
  rescheduleRequests   RescheduleRequest[]

  @@map("agents")
  @@index([status, zoneId])
}

model Order {
  id                    String         @id @default(uuid()) @db.Uuid
  orderNumber           String         @unique @map("order_number") @default(dbgenerated("'LMD-' || EXTRACT(YEAR FROM now()) || '-' || LPAD(nextval('order_number_seq')::text, 6, '0')"))
  idempotencyKey        String?        @map("idempotency_key")
  customerId            String?        @map("customer_id") @db.Uuid
  customer              User?          @relation("OrderCustomer", fields: [customerId], references: [id])
  createdBy             String?        @map("created_by") @db.Uuid
  creator               User?          @relation("OrderCreator", fields: [createdBy], references: [id])
  orderType             OrderType      @map("order_type")
  paymentType           PaymentType    @map("payment_type")
  pickupAddress         String         @map("pickup_address")
  pickupPincode         String         @map("pickup_pincode")
  pickupZoneId          String         @map("pickup_zone_id") @db.Uuid
  pickupZone            Zone           @relation("PickupZone", fields: [pickupZoneId], references: [id])
  dropAddress           String         @map("drop_address")
  dropPincode           String         @map("drop_pincode")
  dropZoneId            String         @map("drop_zone_id") @db.Uuid
  dropZone              Zone           @relation("DropZone", fields: [dropZoneId], references: [id])
  lengthCm              Decimal        @map("length_cm") @db.Decimal(6, 2)
  breadthCm             Decimal        @map("breadth_cm") @db.Decimal(6, 2)
  heightCm              Decimal        @map("height_cm") @db.Decimal(6, 2)
  actualWeightKg        Decimal        @map("actual_weight_kg") @db.Decimal(6, 2)
  volumetricWeightKg    Decimal        @map("volumetric_weight_kg") @db.Decimal(6, 2)
  billedWeightKg        Decimal        @map("billed_weight_kg") @db.Decimal(6, 2)
  rateCardId            String         @map("rate_card_id") @db.Uuid
  rateCard              RateCard       @relation(fields: [rateCardId], references: [id])
  baseCharge            Decimal        @map("base_charge") @db.Decimal(10, 2)
  codSurcharge          Decimal        @default(0) @map("cod_surcharge") @db.Decimal(10, 2)
  totalCharge           Decimal        @map("total_charge") @db.Decimal(10, 2)
  status                OrderStatus    @default(CREATED)
  statusVersion         Int            @default(0) @map("status_version")
  assignedAgentId       String?        @map("assigned_agent_id") @db.Uuid
  assignedAgent         Agent?         @relation(fields: [assignedAgentId], references: [id])
  assignmentType        AssignmentType? @map("assignment_type")
  scheduledDeliveryDate DateTime?      @map("scheduled_delivery_date") @db.Date
  deliveryAttempts      Int            @default(0) @map("delivery_attempts")
  cancellationReason    String?        @map("cancellation_reason")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  trackingEvents        OrderTrackingEvent[]
  rescheduleRequests    RescheduleRequest[]
  notifications         Notification[]

  @@map("orders")
  @@unique([customerId, idempotencyKey])
  @@index([status])
  @@index([assignedAgentId])
  @@index([pickupZoneId, dropZoneId])
}

model OrderTrackingEvent {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  order       Order       @relation(fields: [orderId], references: [id])
  status      OrderStatus
  actorId     String?     @map("actor_id") @db.Uuid
  actor       User?       @relation("TrackingEventActor", fields: [actorId], references: [id])
  actorRole   Role        @map("actor_role")
  note        String?
  latitude    Decimal?    @db.Decimal(9, 6)
  longitude   Decimal?    @db.Decimal(9, 6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@map("order_tracking_events")
  @@index([orderId, createdAt])
}

model RescheduleRequest {
  id                    String   @id @default(uuid()) @db.Uuid
  orderId               String   @map("order_id") @db.Uuid
  order                 Order    @relation(fields: [orderId], references: [id])
  previousScheduledDate DateTime? @map("previous_scheduled_date") @db.Date
  newScheduledDate      DateTime @map("new_scheduled_date") @db.Date
  requestedBy           String?  @map("requested_by") @db.Uuid
  requester             User?    @relation("RescheduleRequester", fields: [requestedBy], references: [id])
  reassignedAgentId     String?  @map("reassigned_agent_id") @db.Uuid
  reassignedAgent       Agent?   @relation(fields: [reassignedAgentId], references: [id])
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("reschedule_requests")
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  orderId     String?             @map("order_id") @db.Uuid
  order       Order?              @relation(fields: [orderId], references: [id])
  channel     NotificationChannel
  recipient   String
  eventType   String              @map("event_type")
  status      NotificationStatus  @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?             @map("last_error")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz

  @@map("notifications")
}
